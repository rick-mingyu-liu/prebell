{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketsite-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // Same database as crates/generator/wrangler.toml; real id set in Task 13.
      "binding": "DB",
      "database_name": "marketsite",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
  // CF_BEACON_TOKEN (Cloudflare Web Analytics) is optional; set it as a var to enable the beacon.
}
