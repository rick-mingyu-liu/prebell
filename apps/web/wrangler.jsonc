{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketsite-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // Same database as crates/generator/wrangler.toml; real id set in Task 13.
      "binding": "DB",
      "database_name": "marketsite",
      "database_id": "d44fa779-4253-41c6-ab8c-1ef478cfc984"
    }
  ],
  "vars": {
    // Origin for canonical and hreflang URLs; placeholder until the domain is chosen.
    "SITE_URL": "https://marketsite-web.workers.dev"
    // CF_BEACON_TOKEN (Cloudflare Web Analytics) is optional; set it as a var to enable the beacon.
  }
}
