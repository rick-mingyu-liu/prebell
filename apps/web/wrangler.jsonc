{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prebell-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      // Same database as crates/generator/wrangler.toml; real id set in Task 13.
      "binding": "DB",
      "database_name": "prebell",
      "database_id": "eb17fcaf-48fd-4956-88c6-d5ef18ac2662"
    }
  ],
  "r2_buckets": [
    {
      // Same bucket as crates/generator/wrangler.toml; the site serves chart SVGs from its charts/ prefix.
      "binding": "FACTS",
      "bucket_name": "prebell-facts"
    }
  ],
  // prebell.site must be an active zone on this account before this deploys. www is served here too
  // and redirected to the apex in next.config.ts. The workers.dev URL stays up for links shared before
  // the domain.
  "routes": [
    { "pattern": "prebell.site", "custom_domain": true },
    { "pattern": "www.prebell.site", "custom_domain": true }
  ],
  "workers_dev": true,
  "vars": {
    // Origin for canonical and hreflang URLs.
    "SITE_URL": "https://prebell.site",
    // The read-only MCP server at /mcp (docs/runbook.md, "MCP server"). Any value other than "true" turns it
    // off: the route answers 404. Changing it needs a redeploy of this Worker.
    "MCP_ENABLED": "true"
    // CF_BEACON_TOKEN (Cloudflare Web Analytics): leave unset. Cloudflare already injects the beacon at the
    // edge (automatic setup); setting it here would add a second one and count visits twice. See docs/runbook.md.
  }
}
